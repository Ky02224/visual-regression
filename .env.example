# Copy this file to .env and fill in real values before running docker-compose up.
LENS_ADMIN_PASSWORD=change-me
LENS_DEVELOPER_PASSWORD=change-me

# Optional overrides — see docker-compose.yml for more examples.
# DATABASE_URL=postgresql://user:pass@db:5432/lens
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# LENS_SECURE_COOKIES=true

# Append a plain-language narration to each classified change, generated by a
# local Ollama vision model (llava). Off by default: the narration is generated
# text, while the explanation it accompanies is evidence read out of the two DOM
# snapshots, and only the latter can be checked against the page. Requires
# `ollama serve` running with `ollama pull llava`.
# VRT_ENABLE_OLLAMA=true
