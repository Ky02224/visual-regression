{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard_frontend", "run", "dev", "--", "--port=3100"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "dashboard-server",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "visual_regression.cli", "serve-dashboard", "--port", "8130"],
      "port": 8130
    }
  ]
}
